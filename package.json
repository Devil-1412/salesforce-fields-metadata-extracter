{
  "name": "salesforce-metadata-extractor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --experimental-https",
    "build": "next build",
    "local": "next dev",
    "bundle:analyze": "set ANALYZE=true && next build",
    "start": "next start",
    "serve": "npm run build && npm start",
    "lint": "next lint",
    "update-mantine": "npx npm-check-updates @mantine/* @mantinex/* postcss-preset-mantine -u",
    "json-server-home": "npx json-server -p 4000 ./src/app/api/home.json",
    "json-server-destination": "npx json-server -p 4001 ./src/app/api/destinations.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.14",
    "@mantine/carousel": "^8.3.14",
    "@mantine/core": "^8.3.12",
    "@mantine/dates": "^8.3.12",
    "@mantine/hooks": "^8.3.12",
    "@mantine/notifications": "^8.3.12",
    "@supabase/supabase-js": "^2.80.0",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.13",
    "@types/uuid": "^11.0.0",
    "codemirror": "^6.0.2",
    "cookie": "^1.1.1",
    "dayjs": "^1.11.19",
    "embla-carousel-react": "^8.6.0",
    "jsforce": "^1.11.0",
    "lucide-react": "^0.553.0",
    "mantine-react-table": "^2.0.0-beta.9",
    "next": "16.0.7",
    "postcss": "^8.4.30",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-simple-code-editor": "^0.14.1",
    "snowflake-sdk": "^2.3.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.0.7",
    "@types/cookie": "^1.0.0",
    "@types/jsforce": "^1.11.6",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "npm": "^10.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3"
  }
}
