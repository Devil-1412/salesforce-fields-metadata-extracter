# Required: backend origin used by the Electron main process for polling jobs
# and posting results. In production this should be your deployed app origin.
AGENT_BACKEND_URL=https://salesforce-fields-metadata-extracte-three.vercel.app/

# Required: backend origin used by the renderer when pairing the agent.
# Keep this the same as AGENT_BACKEND_URL unless you have a separate public origin.
VITE_BACKEND_URL=https://salesforce-fields-metadata-extracte-three.vercel.app/

# Optional: set to false to disable packaged auto-update checks entirely.
AGENT_AUTO_UPDATE_ENABLED=false

# Optional: generic update feed URL for packaged builds.
# This location must serve electron-builder metadata such as latest.yml and release assets.
AGENT_UPDATE_URL=https://salesforce-fields-metadata-extracte-three.vercel.app/oracle-agent

# Optional: update channel name for the generic feed.
AGENT_UPDATE_CHANNEL=latest
